# Copy to .env and edit for YOUR fabric. Everything the launcher and the scripts
# need to know about your cluster lives here — the scripts refuse to run without it.
#
# Values below are examples from the cluster this repo was developed on
# (4x ASUS Ascent GX10, dual-rail 100G RoCEv2 through a switch). A single-rail
# switched fabric only changes the NCCL block, not the recipe. Four nodes cannot
# be direct-cabled: a GB10 has two QSFP ports and a full mesh would need three.

# ---- Ranks and hosts --------------------------------------------------------------
# Rank 0 is the head: it runs the API server on PORT. Launch order is 3 -> 2 -> 1 -> 0.
# RANKn_IP must be the address NCCL/Gloo can reach on the compute fabric (rail A here).
RANK0_IP=10.77.1.11
RANK1_IP=10.77.1.12
RANK2_IP=10.77.1.13
RANK3_IP=10.77.1.14

# ssh destinations for the fan-out scripts (sync-image, sync-weights, teardown,
# preflight), rank order. Aliases from ~/.ssh/config are fine.
SSH_HOSTS="spark-01 spark-02 spark-03 spark-04"

PORT=8000            # OpenAI-compatible API on the head
MASTER_PORT=29521    # torch/vLLM rendezvous port on rank 0

# ---- Fabric / NCCL ----------------------------------------------------------------
# Dual-rail example: one PF per QSFP cage, one per PCIe domain (GB10 socket-direct).
# Single-rail: put one device/interface in each. Check names with `ibdev2netdev`.
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f1
NCCL_SOCKET_IFNAME=enp1s0f0np0,enP2p1s0f1np1
CTRL_IFNAME=enp1s0f0np0            # single iface for Gloo/TP rendezvous (control plane)
NCCL_IB_ADDR_RANGE=10.77.0.0/16    # must cover every rail subnet
NCCL_IB_GID_INDEX=3                # RoCEv2 GID
NCCL_IB_TC=106                     # DSCP 26 << 2 — match your switch QoS profile, or unset

# ---- Model ------------------------------------------------------------------------
# The checkpoint must be on LOCAL NVMe on every node (~122 GiB): the PLE table is
# mmapped and read at runtime — do not serve it over NFS. scripts/sync-weights.sh
# downloads on the head and rsyncs to the rest.
MODEL_HOST_PATH=/var/tmp/models/Qwen3.8-Flash-Next-NVFP4
IMAGE=qwen38-flash-quad:local
SERVED_NAME=qwen3.8-flash-next
REPO_DIR=                    # path of this checkout on every node (default: where the
                             # script runs). fleet_watchdog.sh and prepare-hybrid.sh
                             # assume the SAME path on all four nodes.

# ---- Fan-out transport (optional but strongly recommended) ------------------------
# GB10's ARM cores cap a single AES/SSH stream at ~1 Gbps — rsync-over-ssh moves
# 122 GiB in hours. An rsync DAEMON on the head, exported over the compute rails
# (an isolated L2 segment, so plaintext is fine), moves it at ~16 Gbps. Set up
# /etc/rsyncd.conf with a read-only module and point these at it; empty = fall back
# to rsync-over-ssh / docker save over ssh.
WEIGHTS_RSYNC_URL=           # e.g. rsync://10.77.1.11/models/models/Qwen3.8-Flash-Next-NVFP4
IMAGE_RSYNC_URL=             # e.g. rsync://10.77.1.11/models — module dir where sync-image.sh
                             # drops the image tar for workers to pull
IMAGE_TAR_DIR=/var/tmp       # head-local dir inside that module for the image tar

# ---- Recipe tunables (defaults are the conservative first-boot lane) ---------------
CTX=262144           # native context. 1M lane: YARN=1 CTX=1048576 — gate it first
YARN=0               # 1 = YaRN rope scaling (factor 4) for CTX > 262144
MTP=2                # speculative tokens from the MTP head (0 = off). First TP4 boot
                     # should also be tried with 0 if the drafter fails to load.
SEQS=16              # max concurrent sequences (do not benchmark with 1-2)
GPU_MEM=0.75         # first-boot fraction of the 128 GB unified pool, per node.
                     # Ladder up only through the gate suite; see README.
KV_GIB=              # optional explicit KV pin per rank (GiB) — overrides GPU_MEM
                     # sizing once you know your ceiling, e.g. KV_GIB=24
PREFIX_CACHE=1       # correct with this image's block_size fix
EXACT_TOPK=1         # deterministic QSA top-k; 0 = stock kernel (faster long prefill)
HYBRID=0             # 1 = fp8 side-layers checkpoint (prepare separately, see blazux repo)
EXTRA=               # extra vLLM flags, passed verbatim, last (argparse last-wins)
